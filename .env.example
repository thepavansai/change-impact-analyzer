# Copy to .env (or export these directly) to switch analyzer/report.py's
# explain() from the deterministic template to a real LLM call.
# Leave everything unset to keep the PoC's default, reproducible behavior.
#
# Only ONE provider needs to be configured. If more than one is set,
# priority is: Anthropic > OpenAI-compatible > Ollama.

# --- Option 1: Anthropic --------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# CIA_LLM_MODEL=claude-haiku-4-5-20251001

# --- Option 2: Any OpenAI-compatible endpoint -----------------------------
# (OpenAI, Groq, Together, Mistral, DeepSeek, OpenRouter, xAI, Azure OpenAI...)
# OPENAI_API_KEY=sk-...
# LLM_API_KEY=                 # alternative to OPENAI_API_KEY
# LLM_PROVIDER=openai          # openai | groq | together | mistral | deepseek | openrouter | xai
# LLM_BASE_URL=                # override if LLM_PROVIDER's default doesn't fit
# CIA_LLM_MODEL=gpt-4o-mini

# --- Option 3: Local Ollama (no API key) ----------------------------------
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# CIA_LLM_MODEL=llama3.2
